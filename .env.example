# ==============================================================================
# Environment Configuration: Government Schemes Discovery & RAG Platform
# ==============================================================================

# Runtime Environment (development, staging, production, test)
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=4

# Application Secret Key
SECRET_KEY=gov-schemes-rag-production-insecure-secret-change-me

# Storage Paths (relative to project root or absolute)
DB_PATH=data/schemes_knowledge.db
VECTOR_INDEX_PATH=data/schemes_vector_index.json

# Optional: Google Gemini API Key for dynamic multimodal vision & reasoning
# If omitted, system seamlessly falls back to high-precision offline deterministic engine
GEMINI_API_KEY=
LLM_MODEL_NAME=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=30

# CORS Allowed Origins (comma-separated or * for all)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate Limiting (slowapi)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_ANALYZE=30/minute
RATE_LIMIT_CHAT=60/minute

# Maximum Upload File Size in Bytes (15MB = 15728640)
MAX_UPLOAD_SIZE_BYTES=15728640

# Observability
METRICS_ENABLED=true
